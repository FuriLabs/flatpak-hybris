#!/bin/bash
set -e

configure() {
	if ! [ -e "/usr/bin/flatpak.real" ]; then
		dpkg-divert \
			--rename \
			--package flatpak-hybris \
			--divert "/usr/bin/flatpak.real" \
			--add "/usr/bin/flatpak"
		ln -s "/usr/lib/flatpak-hybris/flatpak-hybris.sh" "/usr/bin/flatpak"
	fi

	if ! [ -e "/usr/bin/bwrap.real" ]; then
		dpkg-divert \
			--rename \
			--package flatpak-hybris \
			--divert "/usr/bin/bwrap.real" \
			--add "/usr/bin/bwrap"
		ln -s "/usr/lib/flatpak-hybris/bwrapwrapper.sh" "/usr/bin/bwrap"
	fi

	# remove the old bwrap setuid state override now that we have a bwrap wrapper
	if dpkg-statoverride --list /usr/bin/bwrap &> /dev/null; then
		[ -u "/usr/bin/bwrap" ] && chmod -s /usr/bin/bwrap
		[ -u "/usr/bin/bwrap.real" ] && chmod -s /usr/bin/bwrap.real

		dpkg-statoverride --quiet --remove /usr/bin/bwrap
	fi
}

case "$1" in
	"configure")
		configure
		;;
esac
